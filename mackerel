# ── Targets with their own steps ────────────────────────────────────────────

cur_paths() { printf '%s\n' "${RESOLVED[$CUR]}"; }

# --force skips the in-use check: MCP servers launched with uvx hold the lock for days.
uv_clean() { uv cache prune --force; }
pnpm_clean() { pnpm store prune; }
brew_clean() { brew cleanup --prune=all; }

# conda hardlinks packages into envs, so only conda knows what is really unused.
conda_clean() {
	local p rc=0
	while IFS= read -r p; do
		if [[ -x "${p%/pkgs}/bin/conda" ]]; then "${p%/pkgs}/bin/conda" clean --all --yes || rc=1; else rc=1; fi
	done < <(cur_paths)
	return "$rc"
}

# Go writes its module cache read-only.
gomod_clean() {
	local p
	if have go; then go clean -modcache; return; fi
	while IFS= read -r p; do chmod -R u+w "$p" && empty_dir "$p"; done < <(cur_paths)
}

sim_udids() {
	xcrun simctl list devices unavailable 2>/dev/null |
		grep -oE '[0-9A-F]{8}-([0-9A-F]{4}-){3}[0-9A-F]{12}'
}
sim_check() { xcrun simctl help >/dev/null 2>&1 || { echo "Xcode not installed"; return 2; }; }
sim_size() {
	local u t=0
	for u in $(sim_udids); do
		t=$((t + $(du_kb "$HOME/Library/Developer/CoreSimulator/Devices/$u")))
	done
	echo "$t"
}
sim_clean() { xcrun simctl delete unavailable; }

# Docker: untagged images and build cache only. Never starts the engine.
docker_up() { pgrep -xq OrbStack || pgrep -q com.docker.backend || pgrep -q colima; }
docker_check() {
	have docker || { echo "not installed"; return 2; }
	docker_up || { echo "Docker is not running"; return 1; }
	with_timeout 5 docker info >/dev/null 2>&1 || { echo "Docker is not responding"; return 1; }
}
docker_size() {
	{
		docker images -f dangling=true --format '{{.Size}}' 2>/dev/null
		docker system df --format '{{.Type}} {{.Reclaimable}}' 2>/dev/null | grep '^Build Cache'
	} | docker_kb
}
docker_clean() { docker image prune -f && docker builder prune -f; }
docker_volumes_kb() {
	docker system df --format '{{.Type}} {{.Reclaimable}}' 2>/dev/null |
		grep '^Local Volumes' | sed 's/([^)]*)//' | docker_kb
}

# Worktrees that coding agents create in <repo>/.claude/worktrees. One goes only
# if it is unlocked, has no changes, and no file in it changed for 24 h, so an
# agent that is still working is never touched. The branch stays in the repo.
agents_list() {
	local wtroot wt gitdir
	((${#CODE_DIRS[@]})) || return 0
	find "${CODE_DIRS[@]}" -maxdepth 4 \( -name node_modules -o -name .git \) -prune \
		-o -type d -path '*/.claude/worktrees' -print 2>/dev/null |
		while IFS= read -r wtroot; do
			for wt in "$wtroot"/*/; do
				wt="${wt%/}"
				[[ -d "$wt" ]] || continue
				gitdir=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null) || continue
				[[ -e "$gitdir/locked" ]] && continue
				[[ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ]] || continue
				[[ -z "$(find "$wt" \( -name node_modules -o -name .next -o -name .git \) -prune \
					-o -type f -mmin -"$WORKTREE_IDLE_MIN" -print -quit 2>/dev/null)" ]] || continue
				printf '%s\n' "$wt"
			done
		done
}
code_check() { ((${#CODE_DIRS[@]})) || { echo "no project folder found"; return 2; }; }
agents_check() { code_check; }
agents_size() { agents_list | du_list; }
agents_clean() {
	local wt repo rc=0
	while IFS= read -r wt; do
		repo="${wt%/.claude/worktrees/*}"
		git -C "$repo" worktree remove "$wt" || rc=1
		git -C "$repo" worktree prune
	done < <(agents_list)
	return "$rc"
}

# Project roots under the code folders, found once per run.
projects() {
	local f="$LOCK_DIR/projects"
	if [[ ! -f "$f" ]]; then
		find "${CODE_DIRS[@]}" -maxdepth 4 \
			\( -name node_modules -o -name .git -o -name target -o -name .venv -o -name venv -o -name Pods \
			-o -name .next -o -name .build -o -name DerivedData -o -name vendor \) -prune \
			-o -type f \( -name package.json -o -name Cargo.toml -o -name pyproject.toml -o -name requirements.txt \) \
			-print 2>/dev/null | sed 's#/[^/]*$##' | sort -u >"$f"
	fi
	cat "$f"
}

projcache_list() {
	local p s
	projects | while IFS= read -r p; do
		for s in .next/cache node_modules/.cache .turbo .parcel-cache .angular/cache; do
			[[ -d "$p/$s" ]] && printf '%s\n' "$p/$s"
		done
	done
}
projcache_check() { code_check; }
projcache_size() { projcache_list | du_list; }
projcache_clean() { local d; projcache_list | while IFS= read -r d; do empty_dir "$d"; done; }

rusttarget_list() {
	local p
	projects | while IFS= read -r p; do
		[[ -f "$p/Cargo.toml" && -d "$p/target" ]] && printf '%s\n' "$p/target"
	done
}
rusttarget_check() {
	code_check || return
	pgrep -xq cargo && { echo "cargo is running"; return 1; }
	return 0
}
rusttarget_size() { rusttarget_list | du_list; }
rusttarget_clean() { local d; rusttarget_list | while IFS= read -r d; do remove_dir "$d"; done; }

# node_modules and virtualenvs of projects where no file changed in STALE_DAYS.
staledeps_list() {
	local p d
	projects | while IFS= read -r p; do
		[[ -d "$p/node_modules" || -f "$p/.venv/pyvenv.cfg" || -f "$p/venv/pyvenv.cfg" ]] || continue
		[[ -z "$(find "$p" \( -name node_modules -o -name .venv -o -name venv -o -name .git -o -name target -o -name .next \) \
			-prune -o -type f -mtime -"$STALE_DAYS" -print -quit 2>/dev/null)" ]] || continue
		[[ -d "$p/node_modules" ]] && printf '%s\n' "$p/node_modules"
		for d in .venv venv; do [[ -f "$p/$d/pyvenv.cfg" ]] && printf '%s\n' "$p/$d"; done
	done
}
staledeps_check() { code_check; }
staledeps_size() { staledeps_list | du_list; }
staledeps_clean() { local d; staledeps_list | while IFS= read -r d; do remove_dir "$d"; done; }

# Transcripts (*.jsonl) only. Claude Code's memory (memory/*.md) stays.
SESSION_ROOTS=("$HOME/.claude/projects" "$HOME/.codex/sessions")
sessions_find() {
	local r
	for r in "${SESSION_ROOTS[@]}"; do
		[[ -d "$r" ]] && find "$r" -type f -name '*.jsonl' -mtime +"$SESSION_DAYS" "$@" 2>/dev/null
	done
}
sessions_check() { [[ -d "${SESSION_ROOTS[0]}" || -d "${SESSION_ROOTS[1]}" ]] || { echo "not on this Mac"; return 2; }; }
sessions_size() { sessions_find -print0 | xargs -0 stat -f %z 2>/dev/null | awk '{ t += $1 } END { printf "%d\n", t / 1024 }'; }
sessions_clean() { sessions_find -delete; }

trash_check() { ls "$HOME/.Trash" >/dev/null 2>&1 || { echo "needs Full Disk Access"; return 1; }; }

# ── Engine ──────────────────────────────────────────────────────────────────

STATE=() SIZE=() WHY=() RESOLVED=() CUR=0 HIDDEN=0

resolve() { # index to existing paths, one per line
	local p
	eval "set -- ${PATHS[$1]}"
	for p in "$@"; do [[ -n "$p" && -e "$p" ]] && printf '%s\n' "$p"; done
}

t_check() { # index; sets WHY and RESOLVED; returns 0 ok, 1 blocked, 2 absent
	local i=$1 id=${IDS[$1]} why rc name re
	if declare -F "${id}_check" >/dev/null; then
		why=$("${id}_check" 2>/dev/null)
		rc=$?
		((rc)) && { WHY[$i]=${why:-unavailable}; return "$rc"; }
	fi
	if [[ -n "${PATHS[$i]}" ]]; then
		RESOLVED[$i]=$(resolve "$i")
		[[ -n "${RESOLVED[$i]}" ]] || { WHY[$i]="not on this Mac"; return 2; }
	fi
	if [[ -n "${APPS[$i]}" ]]; then
		name=${APPS[$i]%%|*} re=${APPS[$i]#*|}
		pgrep -f "$re" >/dev/null 2>&1 && { WHY[$i]="$name is running"; return 1; }
	fi
	return 0
}

t_size() {
	CUR=$1
	if declare -F "${IDS[$1]}_size" >/dev/null; then "${IDS[$1]}_size"; else cur_paths | du_list; fi
}

t_clean() {
	local p rc=0
	CUR=$1
	if declare -F "${IDS[$1]}_clean" >/dev/null; then "${IDS[$1]}_clean"; return; fi
	while IFS= read -r p; do empty_dir "$p" || rc=1; done < <(cur_paths)
	return "$rc"
}

selected() { # index
	if [[ -n "$ONLY" ]]; then
		[[ ",$ONLY," == *",${IDS[$1]},"* ]]
	else
		[[ "${TIERS[$1]}" == safe || "$DEEP" == 1 || "$DRY" == 1 ]]
	fi
}

# Fills STATE: ok (to clean), blocked (shown with a reason), empty and absent
# (hidden unless --all or --only).
measure() {
	local i rc kb
	for i in "${!IDS[@]}"; do
		selected "$i" || continue
		status "measuring ${LABELS[$i]}…"
		t_check "$i"
		rc=$?
		SIZE[$i]=0
		if ((rc == 2)); then
			STATE[$i]=absent
		elif ((rc == 1)); then
			[[ -n "${RESOLVED[$i]:-}" ]] && SIZE[$i]=$(t_size "$i")
			if [[ -z "${RESOLVED[$i]:-}" ]] || ((SIZE[i] >= 1024)); then STATE[$i]=blocked; else STATE[$i]=empty; fi
		else
			kb=$(t_size "$i" 2>/dev/null)
			SIZE[$i]=${kb:-0}
			if ((SIZE[i] < 1024)); then STATE[$i]=empty; else STATE[$i]=ok; fi
		fi
		[[ "${STATE[$i]}" == empty || "${STATE[$i]}" == absent ]] && HIDDEN=$((HIDDEN + 1))
	done
	status_clear
}

# ── Draw ────────────────────────────────────────────────────────────────────

header() { # $1 title
	local total free pct fill full rest c
	read -r total free < <(disk)
	pct=$((100 - free * 100 / total))
	fill=$((pct * 24 / 100))
	if ((pct >= 95)); then c=$RED; elif ((pct >= 85)); then c=$YEL; else c=$GRN; fi
	full=$(printf '%*s' "$fill" '' | sed 's/ /█/g')
	rest=$(printf '%*s' $((24 - fill)) '' | sed 's/ /░/g')
	say ""
	say "  ${D}><${R}${CYN}≋≋≋${R}${D}°>${R}  ${B}mackerel${R}${1:+  ${D}$1${R}}"
	say ""
	say "  ${c}${full}${R}${D}${rest}${R}   ${B}$(human "$free") free${R} ${D}of $(human "$total"), ${pct}% full${R}"
}

# printf pads by bytes, which breaks on multibyte text. This pads by characters.
pad() { # text width [r = right-align]
	local s="$1" f
	f=$(printf "%*s" $(($2 - ${#s})) "")
	if [[ "${3:-}" == r ]]; then printf "%s%s" "$f" "$s"; else printf "%s%s" "$s" "$f"; fi
}

row() { # id label size note [color]
	printf "  ${D}%-12s${R}%s%s%s${R}  ${D}%s${R}\n" "$1" "${5:-}" "$(pad "$2" 36)" "$(pad "$3" 10 r)" "$4"
}

by_size() { # tier state; indexes, biggest first
	local i
	for i in "${!IDS[@]}"; do
		[[ "${TIERS[$i]}" == "$1" && "${STATE[$i]:-}" == "$2" ]] && printf '%s %s\n' "${SIZE[$i]}" "$i"
	done | sort -rn | awk '{ print $2 }'
}

section() { # tier title subtitle
	local i shown=0 st size note
	for st in ok blocked empty absent; do
		[[ "$st" == empty || "$st" == absent ]] && ((!ALL)) && [[ -z "$ONLY" ]] && continue
		for i in $(by_size "$1" "$st"); do
			if ((!shown)); then say ""; say "  ${B}$2${R}  ${D}$3${R}"; shown=1; fi
			case "$st" in
			ok) row "${IDS[$i]}" "${LABELS[$i]}" "$(human "${SIZE[$i]}")" "${NOTES[$i]}" ;;
			blocked)
				size="-"; ((SIZE[i])) && size=$(human "${SIZE[$i]}")
				row "${IDS[$i]}" "${LABELS[$i]}" "$size" "${WHY[$i]}" "$D" ;;
			*)
				note="nothing to free"; [[ "$st" == absent ]] && note="${WHY[$i]}"
				row "${IDS[$i]}" "${LABELS[$i]}" "-" "$note" "$D" ;;
			esac
		done
	done
}

total_of() { # tier to freeable KB
	local i t=0
	for i in "${!IDS[@]}"; do
		[[ "${TIERS[$i]}" == "$1" && "${STATE[$i]:-}" == ok ]] && t=$((t + SIZE[i]))
	done
	echo "$t"
}

hidden_note() {
	((HIDDEN)) && ((!ALL)) && [[ -z "$ONLY" ]] &&
		say "  ${D}$HIDDEN more targets have nothing to free on this Mac. --all lists them.${R}"
	return 0
}

# Things people keep on purpose. mackerel reports them and never deletes them.
HINTS=()
hint_dir() { # min_kb label advice path...
	local min=$1 label=$2 advice=$3 kb
	shift 3
	kb=$(du_kb "$@")
	((kb >= min)) && HINTS+=("$label: $(human "$kb"). $advice")
	return 0
}
hints() {
	local v n
	status "looking for things to check by hand…"
	HINTS=()
	if docker_check >/dev/null 2>&1; then
		v=$(docker_volumes_kb)
		((v >= GB)) && HINTS+=("Unused Docker volumes: $(human "$v"). They may hold databases; go through docker volume ls.")
	fi
	hint_dir $GB "iPhone and iPad backups" "Delete old ones in Finder, under your device." \
		"$AS/MobileSync/Backup"
	hint_dir $GB "Xcode archives" "Keep the ones for builds you shipped; Xcode's Organizer deletes the rest." \
		"$HOME/Library/Developer/Xcode/Archives"
	hint_dir $GB "Android emulators" "Delete unused ones in Android Studio's Device Manager." \
		"${ANDROID_USER_HOME:-$HOME/.android}/avd"
	hint_dir $GB "Ollama models" "ollama list, then ollama rm the ones you don't use." \
		"${OLLAMA_MODELS:-$HOME/.ollama/models}"
	hint_dir $GB "LM Studio models" "Remove unused ones under My Models in LM Studio." \
		"$HOME/.lmstudio/models" "$XC/lm-studio/models"
	hint_dir $GB "Vagrant boxes" "vagrant box prune removes old versions." \
		"${VAGRANT_HOME:-$HOME/.vagrant.d}/boxes"
	hint_dir $GB "Virtual machines" "Delete the ones you no longer run." \
		"$HOME/Library/Containers/com.utmapp.UTM/Data/Documents" "$HOME/Parallels" "$HOME/Virtual Machines.localized"
	hint_dir $((5 * GB)) "Downloads" "Sort by size in Finder and see what you still need." "$HOME/Downloads"
	n=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c 'com.apple.TimeMachine')
	((n > 0)) && HINTS+=("$n local Time Machine snapshots keep deleted files on disk until macOS drops them.")
	status_clear
	((${#HINTS[@]})) || return 0
	say ""
	say "  ${B}Check by hand${R}  ${D}mackerel never deletes these${R}"
	for v in "${HINTS[@]}"; do say "  ${D}·${R} $v"; done
}

# ── Run ─────────────────────────────────────────────────────────────────────

run() {
	local total free i id before after freed sum=0 failed=0 n=0 ans s p
	if [[ -n "$BELOW" ]]; then
		read -r total free < <(disk)
		if ((free / GB >= BELOW)); then
			say "mackerel: $(human "$free") free, above the $BELOW GB threshold. Nothing to do."
			log "threshold	free=${free}KB	threshold=${BELOW}GB	skipped"
			return 0
		fi
	fi

	if ((DRY)); then header "dry run"; else header ""; fi
	measure
	section safe Safe "refilled by its tool"
	if ((DEEP)) || [[ -n "$ONLY" ]]; then section deep Deep "refilled at a cost"; else section deep Deep "only with --deep"; fi

	if ((DRY)); then
		s=$(total_of safe) p=$(total_of deep)
		say ""
		if ((DEEP)) || [[ -n "$ONLY" ]]; then
			say "  ${B}Up to $(human $((s + p))) can be freed.${R}"
		else
			say "  ${B}Up to $(human "$s") can be freed.${R}${D} --deep adds $(human "$p").${R}"
		fi
		hidden_note
		hints
		say ""
		say "  ${D}Dry run: nothing was touched.${R}"
		say ""
		return 0
	fi

	for i in "${!IDS[@]}"; do [[ "${STATE[$i]:-}" == ok ]] && n=$((n + 1)); done
	say ""
	hidden_note
	if ((n == 0)); then
		say "  Nothing to free."
		hints
		say ""
		return 0
	fi

	if ((!YES)); then
		if ((n == 1)); then printf '  Clean this target?'; else printf '  Clean these %d targets?' "$n"; fi
		printf ' %s[y/N]%s ' "$D" "$R"
		read -r ans </dev/tty
		[[ "$ans" == [yY]* ]] || { say "  Nothing changed."; say ""; return 0; }
		say ""
	fi

	log "start	targets=$n	deep=$DEEP"
	for i in "${!IDS[@]}"; do
		[[ "${STATE[$i]:-}" == ok ]] || continue
		id="${IDS[$i]}" before="${SIZE[$i]}"
		status "cleaning ${LABELS[$i]}…"
		if { printf '── %s\n' "$id"; t_clean "$i"; } >>"$LOG_FILE" 2>&1; then
			after=$(t_size "$i" 2>/dev/null)
			freed=$((before - ${after:-0}))
			((freed < 0)) && freed=0
			sum=$((sum + freed))
			status_clear
			row "$id" "${LABELS[$i]}" "$(human "$freed")" "freed" "$GRN"
			log "ok	$id	freed=${freed}KB"
		else
			failed=$((failed + 1))
			status_clear
			row "$id" "${LABELS[$i]}" "failed" "see the log" "$RED"
			log "error	$id"
		fi
	done

	read -r total free < <(disk)
	say ""
	say "  ${B}Freed $(human "$sum").${R}${D} Now $(human "$free") free of $(human "$total").${R}"
	((failed)) && say "  ${RED}$failed failed.${R} ${D}Log: ${LOG_FILE/#$HOME/~}${R}"
	hints
	say ""
	log "end	freed=${sum}KB	free=${free}KB	errors=$failed"
	((failed == 0))
}

cmd_help() {
	cat <<EOF

  ${B}mackerel${R} ${D}$VERSION${R}  free disk space on a Mac without losing work

  ${B}Usage${R}
    mackerel [options]           show what can be freed, ask, clean

  ${B}Options${R}
    -n, --dry-run                show what can be freed and stop
    -d, --deep                   include the deep tier
    -a, --all                    also list targets with nothing to free
    -y, --yes                    don't ask (for cron and launchd)
        --if-below <GB>          run only when free space is under this
        --only <id,id>           only these targets (--dry-run --all lists the ids)
    -h, --help                   this text
    -v, --version                print the version

  ${B}Examples${R}
    mackerel --dry-run --deep
    mackerel --only npm,docker
    mackerel --yes --if-below 60

  ${B}Every evening${R}  ${D}(crontab -e)${R}
    0 21 * * *  $HOME/Code/mackerel/mackerel --yes --if-below 60

  ${B}Never deleted${R}
    Docker volumes, models, backups, VMs and Xcode archives (reported only);
    worktrees with changes, locked, or used in the last 24 h; app caches while
    the app is open; Claude Code's memory; anything outside your home folder

  ${B}Environment${R}
    MACKEREL_CODE_DIR            project folders, colon separated ${D}(found on their own)${R}
    MACKEREL_STALE_DAYS          idle days before a project's dependencies go ${D}(90)${R}
    MACKEREL_SESSION_DAYS        age of agent sessions to delete ${D}(30)${R}
    NO_COLOR                     no colors

  ${D}Log: ${LOG_FILE/#$HOME/~}${R}
  ${D}Exit codes: 0 done, 1 something failed, 2 usage error, 3 already running${R}

EOF
}

# ── Arguments ───────────────────────────────────────────────────────────────

DRY=0 DEEP=0 ALL=0 YES=0 BELOW="" ONLY=""

while (($#)); do
	case "$1" in
	-h | --help) cmd_help; exit 0 ;;
	-v | --version) say "mackerel $VERSION"; exit 0 ;;
	-n | --dry-run) DRY=1 ;;
	-d | --deep) DEEP=1 ;;
	-a | --all) ALL=1 ;;
	-y | --yes) YES=1 ;;
	--if-below)
		[[ "${2:-}" =~ ^[0-9]+$ ]] || { err "--if-below takes a number of GB"; exit 2; }
		BELOW=$2; shift ;;
	--only)
		[[ -n "${2:-}" ]] || { err "--only takes one or more ids, comma separated"; exit 2; }
		ONLY=$2; shift
		for id in ${ONLY//,/ }; do
			[[ " ${IDS[*]} " == *" $id "* ]] || { err "unknown target: $id (mackerel --dry-run --all lists them)"; exit 2; }
		done ;;
	*) err "unknown option: $1 (try: mackerel --help)"; exit 2 ;;
	esac
	shift
done

if ((!DRY && !YES)) && [[ ! -t 0 ]]; then
	err "no terminal to ask on; add --yes"
	exit 2
fi

# One run at a time: two cleanups in parallel measure wrong and get in each other's way.
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	pid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
	if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
		err "already running (pid $pid)"
		exit 3
	fi
	rm -rf "$LOCK_DIR" && mkdir "$LOCK_DIR" || { err "cannot create $LOCK_DIR"; exit 3; }
fi
echo $$ >"$LOCK_DIR/pid"
trap 'status_clear; rm -rf "$LOCK_DIR"' EXIT
trap 'exit 130' INT TERM
mkdir -p "$(dirname "$LOG_FILE")"

run
