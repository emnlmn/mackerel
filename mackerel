#!/bin/bash
# mackerel: free disk space on a Mac without losing work.
#
#   mackerel                 show what can be freed, ask, clean
#   mackerel --dry-run       show what can be freed and stop
#   mackerel --help          options and examples
#
# Two tiers. Safe: caches their tool refills on its own. Deep (--deep): caches
# too, but refilling costs a big download, a rebuild, or drops something old.
# Libraries people build up on purpose (models, backups, VMs, Docker volumes,
# Xcode archives) are only reported, never deleted.
#
# Written for macOS's bash 3.2, so no associative arrays and no mapfile.

set -o pipefail

VERSION="1.1"
SESSION_DAYS="${MACKEREL_SESSION_DAYS:-30}"
STALE_DAYS="${MACKEREL_STALE_DAYS:-90}"
WORKTREE_IDLE_MIN=1440 # an agent worktree counts as finished after 24 h idle
LOG_FILE="$HOME/Library/Logs/mackerel.log"
LOCK_DIR="${TMPDIR:-/tmp}/mackerel.lock"
XC="${XDG_CACHE_HOME:-$HOME/.cache}"
AS="$HOME/Library/Application Support"
GB=1048576

# cron and launchd start with a bare PATH, where most tools are missing.
PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export LC_CTYPE=UTF-8 # makes ${#s} count characters, not bytes (cron has no LANG)

# Folders that hold your projects: MACKEREL_CODE_DIR (colon separated), or every
# usual name that exists. Deduplicated by inode, since ~/Code and ~/code are one
# folder on a case-insensitive disk.
CODE_DIRS=()
if [[ -n "${MACKEREL_CODE_DIR:-}" ]]; then
	IFS=: read -r -a _cands <<<"$MACKEREL_CODE_DIR"
else
	_cands=("$HOME"/{Code,code,Projects,projects,Developer,dev,Dev,src,workspace,Workspace,repos,git,GitHub,github})
fi
_seen=" "
for _d in "${_cands[@]}"; do
	[[ -d "$_d" ]] || continue
	_ino=$(stat -f %i "$_d")
	[[ "$_seen" == *" $_ino "* ]] && continue
	_seen+="$_ino " CODE_DIRS+=("$_d")
done

# ── Terminal ────────────────────────────────────────────────────────────────

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != dumb ]]; then
	TTY=1
	B=$'\e[1m' D=$'\e[2m' R=$'\e[0m'
	CYN=$'\e[36m' RED=$'\e[31m' GRN=$'\e[32m' YEL=$'\e[33m'
else
	TTY=0 B='' CYN='' D='' R='' RED='' GRN='' YEL=''
fi

say() { printf '%s\n' "$*"; }
err() { printf '%s\n' "${RED}mackerel:${R} $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

# A status line that rewrites itself (terminal only).
status() { ((TTY)) && printf '\r\e[K  %s%s%s' "$D" "$*" "$R" >&2; }
status_clear() { ((TTY)) && printf '\r\e[K' >&2; }

# KB to "20.1 GB", "512 MB".
human() {
	LC_ALL=C awk -v k="${1:-0}" 'BEGIN {
		if (k >= 1048576) printf "%.1f GB\n", k / 1048576
		else if (k >= 1024) printf "%d MB\n", k / 1024
		else printf "%d KB\n", k }'
}

# Docker's "4.065GB", "512MB", "0B" to KB.
docker_kb() {
	awk '{ for (i = 1; i <= NF; i++) {
		v = $i; if (v !~ /^[0-9.]+[kKMGT]?B$/) continue
		n = v + 0; u = v; gsub(/[0-9.]/, "", u)
		m = (u == "B") ? 1/1000 : (u ~ /^k/) ? 1 : (u == "MB") ? 1000 : (u == "GB") ? 1e6 : 1e9
		t += n * m * 1000 / 1024 } } END { printf "%d\n", t }'
}

du_kb() { # du -sk summed over the paths that exist
	local p t=0 k
	for p in "$@"; do
		[[ -e "$p" ]] || continue
		k=$(du -sk "$p" 2>/dev/null | awk '{print $1}')
		t=$((t + ${k:-0}))
	done
	echo "$t"
}

du_list() { # same, for paths on stdin, one per line
	local p t=0
	while IFS= read -r p; do [[ -n "$p" ]] && t=$((t + $(du_kb "$p"))); done
	echo "$t"
}

inside_home() { [[ -n "$1" && "$1" == "$HOME"/?* && -e "$1" ]]; }

# Empties a directory and keeps it. Refuses anything outside $HOME.
empty_dir() {
	inside_home "$1" && [[ -d "$1" ]] || return 1
	find "$1" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
}

# Removes a directory. Refuses anything outside $HOME.
remove_dir() {
	inside_home "$1" || return 1
	rm -rf "$1"
}

with_timeout() { perl -e 'alarm shift; exec @ARGV' "$@"; }

disk() { df -k "$HOME" | awk 'NR == 2 { print $2, $4 }'; } # total and free, in KB

log() { printf '%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG_FILE"; }

# ── Targets ─────────────────────────────────────────────────────────────────
#
#   reg id tier "label" "note" 'paths' ['Name|process regex']
#
# paths is shell text, evaluated when the target is measured, so it can ask the
# tool where its cache lives or honour the tool's own variable. Paths that don't
# exist are dropped; a target with none left doesn't apply to this Mac. With a
# process regex, the target waits while that app runs: apps rewrite their cache
# while open.
#
# By default a target is measured with du and cleaned by emptying its paths. A
# target can replace any step with its own function:
#   <id>_check  prints why it can't run; returns 1 (shown) or 2 (not on this Mac)
#   <id>_size   prints KB
#   <id>_clean  does the work; cur_paths lists the resolved paths

IDS=() TIERS=() LABELS=() NOTES=() PATHS=() APPS=()
reg() { IDS+=("$1"); TIERS+=("$2"); LABELS+=("$3"); NOTES+=("$4"); PATHS+=("${5:-}"); APPS+=("${6:-}"); }

# An Electron app keeps the same cache folders in every profile it has.
electron() { # id tier label "App" regex base...
	local id=$1 tier=$2 label=$3 app=$4 re=$5 b s p=""
	shift 5
	for b in "$@"; do
		for s in Cache "Code Cache" GPUCache CachedData CachedExtensionVSIXs DawnCache DawnGraphiteCache DawnWebGPUCache "Service Worker/CacheStorage"; do
			p+="\"$b/$s\" "
		done
	done
	reg "$id" "$tier" "$label" "rebuilt when $app opens" "$p" "$app|$re"
}

